# quorum — high-level architecture (overview).
# Dense per-component detail lives in architecture-detailed.d2.
# Regenerate SVGs after editing: d2 architecture.d2 architecture.svg

direction: right

title: quorum — a deterministic pod shop, harnessed by Claude Code {
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

# ──────────────────────────────────────────────
# STRATEGY -> ENGINE (deterministic, no LLM)
# ──────────────────────────────────────────────
strategy: strategies/*.yaml\nclosed-grammar, git-committed {
  shape: oval
  style: {fill: "#ffffff"; stroke: "#9ca3af"}
}
gate: Backtest gate\nDSR · PBO · WFE · 3x cost-stress {
  style: {fill: "#ede9fe"; stroke: "#8b5cf6"}
}
engine: Strategy engine\nbar loop · features · sizing {
  style: {fill: "#dcfce7"; stroke: "#10b981"; bold: true}
}

strategy -> gate: must pass
gate -> engine: promoted

# ──────────────────────────────────────────────
# POD (one PM + one analyst per strategy)
# ──────────────────────────────────────────────
pod: Pod Shop {
  style: {fill: "#f9fafb"; stroke: "#9ca3af"; border-radius: 10}

  candidates: get_pod_candidates\nranked entries {
    style: {fill: "#eff6ff"; stroke: "#3b82f6"}
  }
  exits: get_pod_exits\nstop-loss · max-hold · rule-exit {
    style: {fill: "#fee2e2"; stroke: "#ef4444"}
  }
  analyst: pod-analyst\nevidence only — no score {
    style: {fill: "#f5e8d6"; stroke: "#a85f17"}
  }
  pm: pod-pm\napprove / reduce / veto {
    style: {fill: "#f5e8d6"; stroke: "#a85f17"; bold: true}
  }

  candidates -> analyst
  analyst -> pm
}

engine -> pod.candidates
engine -> pod.exits

# ──────────────────────────────────────────────
# RISK DESK + EXECUTION
# ──────────────────────────────────────────────
risk: Pre-trade hook\ncentral risk desk — outside every pod {
  style: {fill: "#fee2e2"; stroke: "#ef4444"}
}
broker: Paper broker fill {
  style: {fill: "#dcfce7"; stroke: "#10b981"}
}

pod.pm -> risk: target_weight
pod.exits -> risk: full unwind
risk -> broker

# ──────────────────────────────────────────────
# LOG + SHADOW
# ──────────────────────────────────────────────
log: Decision log (SQLite)\nrun → signal → target → order → fill {
  shape: cylinder
  style: {fill: "#e1eaf3"; stroke: "#2e5c8a"}
}
shadow_sleeve: Shadow sleeve\nsame signals, equal-weight, no pod {
  style: {fill: "#dcfce7"; stroke: "#10b981"}
}
ui: Electron desktop app\nReact UI ← Flask JSON API {
  style: {fill: "#dbeafe"; stroke: "#3b82f6"; border-radius: 10}
}

broker -> log
pod.candidates -> log: logged {style.stroke-dash: 4}
pod.exits -> log: logged {style.stroke-dash: 4}
engine -> shadow_sleeve: parallel {style.stroke-dash: 4}
shadow_sleeve -> log
shadow_sleeve -> pod.pm: beats pod? {style.stroke-dash: 4}
log -> ui: reads
