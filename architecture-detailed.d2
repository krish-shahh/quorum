# quorum — detailed architecture (per-component).
# High-level summary lives in architecture.d2.
# Regenerate SVGs after editing: d2 architecture-detailed.d2 architecture-detailed.svg

direction: down

# ══════════════════════════════════════════════════════════════
# RUNTIME HARNESS
# ══════════════════════════════════════════════════════════════

runtime: RUNTIME HARNESS {
  style.fill: "#f9fafb"
  style.stroke: "#d1d5db"
  style.border-radius: 8

  you: You (terminal or headless) {
    style.fill: "#fff"
    style.stroke: "#d1d5db"
  }
  claude: Claude Code\n(session default model) {
    style.fill: "#eff6ff"
    style.stroke: "#3b82f6"
  }
  mcp: MCP Server (stdio)\n44 Python tools {
    style.fill: "#f0fdf4"
    style.stroke: "#10b981"
  }
  dashboard: Electron desktop app\n(React UI + Flask JSON API backend) {
    style.fill: "#eff6ff"
    style.stroke: "#3b82f6"
  }
  cron: quorum cycle\n(traced headless claude -p)\nno schedule deployed right now {
    style.fill: "#fffbeb"
    style.stroke: "#f59e0b"
  }
  hooks: Hooks\npre_trade_validate.py\npost_tool_audit.py {
    style.fill: "#fef2f2"
    style.stroke: "#fca5a5"
  }

  you -> claude: /pod-cycle
  claude -> mcp: stdio JSON-RPC
  mcp -> dashboard: SQLite
  cron -> claude: claude -p (headless)
  claude -> hooks: pre/post tool
}

# ══════════════════════════════════════════════════════════════
# STRATEGY ENGINE (deterministic — no LLM)
# ══════════════════════════════════════════════════════════════

engine_layer: STRATEGY ENGINE (quorum/strategy/) — no LLM {
  style.fill: "#f0fdf4"
  style.stroke: "#10b981"
  style.stroke-dash: 5
  style.border-radius: 10

  yaml: strategies/*.yaml\n\nClosed-grammar Pydantic schema\nextra="forbid" at every level\nuniverse · features · signal\nsizing · risk · execution {
    style.fill: "#fff"
    style.stroke: "#e5e7eb"
  }

  gate: Backtest acceptance gate\n(quorum/strategy/gate.py)\n\nDeflated Sharpe Ratio\nPBO via CSCV\nWalk-forward efficiency\n3x cost-stress {
    style.fill: "#f5f3ff"
    style.stroke: "#8b5cf6"
  }

  bar_loop: Bar-loop engine\n(engine.py)\n\nSame code path for\nbacktest / paper / shadow\nFills at next bar's open {
    style.fill: "#f0fdf4"
    style.stroke: "#10b981"
  }

  features: Feature computation\n(features.py)\n\nSMA, RSI, ATR, vol-target sizing\nregime-scaled weight {
    style.fill: "#f0fdf4"
    style.stroke: "#10b981"
  }

  candidates: candidates.py\n\ngenerate_candidates() → ranked entries\ncheck_exits() → stop-loss, max-hold,\nrule-exit {
    style.fill: "#eff6ff"
    style.stroke: "#3b82f6"
  }

  yaml -> gate: must pass
  gate -> bar_loop: promoted
  bar_loop -> features
  features -> candidates
}

# ══════════════════════════════════════════════════════════════
# POD SHOP (one PM + one analyst per strategy)
# ══════════════════════════════════════════════════════════════

pod_layer: "POD SHOP — one pod per strategies/*.yaml" {
  style.fill: "#fdf6ec"
  style.stroke: "#a85f17"
  style.stroke-dash: 5
  style.border-radius: 10

  discover: pod-cycle: discover pods\n\nGlob strategies/*.yaml\nProcess alphabetically\nNo cross-pod priority yet {
    style.fill: "#f8fafc"
    style.stroke: "#6b7280"
  }

  exit_check: get_pod_exits(strategy_id)\n\nMechanical — skips analyst/PM\nStop-loss, max holding days,\nstrategy's own exit condition\n\nFix for original failure mode:\nwinners cut, losers held 10-22d {
    style.fill: "#fef2f2"
    style.stroke: "#ef4444"
  }

  entry_candidates: get_pod_candidates(strategy_id)\n\nRanked by proposed weight\nSTALE DATA WARNING passed\nthrough to pod-pm, not dropped {
    style.fill: "#eff6ff"
    style.stroke: "#3b82f6"
  }

  analyst: pod-analyst (Sonnet)\n\nEvidence extraction ONLY:\n  news / SEC filing deltas\n  earnings proximity\nNo score, no buy/sell call —\nliterature doesn't support LLM\njudgment on price/indicators {
    style.fill: "#fdf6ec"
    style.stroke: "#a85f17"
    style.border-radius: 6
  }
  analyst_tools: MCP Tools:\n• get_news / get_global_news\n• get_sec_filings\n• get_earnings_calendar\n• get_congress_trades {
    style.fill: "#f0fdf4"
    style.stroke: "#86efac"
  }

  pm: pod-pm (Fable 5)\n\napprove / reduce / veto\n\nNever invents a trade the\nstrategy didn't propose\nNever sizes above proposed weight\nEvery decision → record_pod_decision {
    style.fill: "#fdf6ec"
    style.stroke: "#a85f17"
    style.border-radius: 6
    style.bold: true
  }
  pm_tools: MCP Tools:\n• get_portfolio / get_portfolio_risk\n• get_live_risk\n• get_trade_reflections\n• get_pod_evidence {
    style.fill: "#f0fdf4"
    style.stroke: "#86efac"
  }

  discover -> exit_check
  discover -> entry_candidates
  entry_candidates -> analyst
  analyst -> analyst_tools
  analyst -> pm: evidence
  pm -> pm_tools
}

# ══════════════════════════════════════════════════════════════
# RISK DESK + EXECUTION
# ══════════════════════════════════════════════════════════════

execution: RISK DESK + EXECUTION {
  style.fill: "#f0fdf4"
  style.stroke: "#10b981"
  style.stroke-dash: 5
  style.border-radius: 10

  live_risk: get_live_risk\n\nGREEN / YELLOW / ORANGE / RED\nATR stop distance checks\nDaily P&L circuit breakers\nVIX spike detection\nRED auto-triggers kill switch {
    style.fill: "#fef2f2"
    style.stroke: "#ef4444"
  }

  pre_hook: Pre-Trade Hook (blocking)\n(pretrade.py — outside every pod)\n\n• Sector cap\n• Single-ticker cap\n• Cash reserve (regime-conditional)\n• Blocked tickers (rules.json)\n• Kill switch {
    style.fill: "#fef2f2"
    style.stroke: "#fca5a5"
  }

  broker: Paper Broker\n\nSpread/slippage model\nMarket impact\nDual persistence: SQLite + JSON {
    style.fill: "#f0fdf4"
    style.stroke: "#10b981"
  }

  live_risk -> pre_hook
  pre_hook -> broker
}

# ══════════════════════════════════════════════════════════════
# DECISION LOG + SHADOW SLEEVE
# ══════════════════════════════════════════════════════════════

log_layer: DECISION LOG + SHADOW SLEEVE {
  style.fill: "#f8fafc"
  style.stroke: "#d1d5db"
  style.stroke-dash: 5
  style.border-radius: 10

  db: SQLite Decision Log\n(decision_log.py)\n\nrun → signal → target →\norder_intent → fill → closed_trade\n+ journal (pod decisions)\n+ daily_recap / run_recap / trace_event\n\nSame schema for backtest/paper/\nshadow/live — a loss decomposes\ninto bad alpha, sizing, or execution {
    style.fill: "#f5f3ff"
    style.stroke: "#c4b5fd"
  }

  shadow_sleeve: Shadow Sleeve\n(shadow.py)\n\nSame signals, equal-weighted,\nno pod, runs in parallel\n\nAnswer to PortBench: LLM portfolio\nconstruction loses to equal-weight\nin 27/30 tested configs\n\nIf a pod doesn't beat its shadow\nsleeve over a rolling 6mo, pod-pm's\nauthority is meant to be cut to\nevidence-only {
    style.fill: "#dcfce7"
    style.stroke: "#10b981"
  }

  wiki: Wiki Knowledge Base\n(quorum/wiki/)\n\nrun pages, digests,\nticker pages, regimes {
    style.fill: "#fff"
    style.stroke: "#e5e7eb"
  }

  reflection: get_trade_reflections\n\nPast outcome lessons,\ninjected into pod-pm's prompt {
    style.fill: "#fff"
    style.stroke: "#e5e7eb"
  }

  db -> wiki
  shadow_sleeve -> db
}

# ══════════════════════════════════════════════════════════════
# DATA LAYER
# ══════════════════════════════════════════════════════════════

data: DATA LAYER (quorum/dataflows/) {
  style.fill: "#fffbeb"
  style.stroke: "#f59e0b"
  style.stroke-dash: 5
  style.border-radius: 10

  yfinance: yfinance (primary)\nFinnhub (fallback)\n\nOHLCV, fundamentals,\nfinancial statements,\ninsider transactions,\nearnings calendar {
    style.fill: "#fffbeb"
    style.stroke: "#fcd34d"
  }
  macro: Macro / Regime\n\nFRED macro series\nSector rotation\nVIX / DXY / yields {
    style.fill: "#fffbeb"
    style.stroke: "#fcd34d"
  }
  alt: Alt Data\n\nReddit, StockTwits\nCongressional trades (incl.\nSenate via CongressInvests)\nSEC filings (data.sec.gov) {
    style.fill: "#fffbeb"
    style.stroke: "#fcd34d"
  }
  cache: TTL Cache Layer\n\nprice: 60s · technicals: 60s\nfundamentals: 86400s\nnews: 3600s · sentiment: 900s\nregime: 300s {
    style.fill: "#fff"
    style.stroke: "#e5e7eb"
  }
}

# ══════════════════════════════════════════════════════════════
# FLOW CONNECTIONS
# ══════════════════════════════════════════════════════════════

runtime -> engine_layer: /pod-cycle {style.stroke-dash: 3}
engine_layer.candidates -> pod_layer.entry_candidates: get_pod_candidates {style.stroke: "#3b82f6"}
engine_layer.candidates -> pod_layer.exit_check: get_pod_exits {style.stroke: "#ef4444"}
pod_layer.pm -> execution.pre_hook: target_weight {style.stroke: "#a85f17"}
pod_layer.exit_check -> execution.pre_hook: full unwind {style.stroke: "#ef4444"}
execution -> log_layer: writes fills {style.stroke-dash: 3}
data -> engine_layer: OHLCV / features {style.stroke-dash: 3}
data -> pod_layer.analyst: news / filings / earnings {style.stroke-dash: 3}
log_layer.reflection -> pod_layer.pm: past lessons {style.stroke-dash: 3}
log_layer.db -> runtime.dashboard: reads {style.stroke-dash: 3}
